@page "/dashboard/drawer-test"
@rendermode RenderMode.InteractiveServer


<PageTitle>Drawer Test</PageTitle>

<h3>MudDrawer Test</h3>

<MudButton OnClick="ToggleDrawer">Toggle Right Drawer (Current: @_openRight)</MudButton>

<MudDrawer @bind-Open="@_openRight" Anchor="Anchor.Right" Elevation="1" Variant="@DrawerVariant.Temporary">
    <MudDrawerHeader>
        <MudText Typo="Typo.h6">Settings</MudText>
    </MudDrawerHeader>
    <MudNavMenu>
        <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.AccountBox">Profile</MudNavLink>
        <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ShoppingCart">Orders</MudNavLink>
        <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.History">Order History</MudNavLink>
    </MudNavMenu>
</MudDrawer>

@code {
    private bool _openRight = false; // 确保初始值为 false

    protected override void OnInitialized()
    {
        Console.WriteLine($"OnInitialized: _openRight is {_openRight}"); // 调试输出
        base.OnInitialized();
    }

    private void ToggleDrawer()
    {
        _openRight = !_openRight;
        Console.WriteLine($"ToggleDrawer called. _openRight is now: {_openRight}");
    }
}